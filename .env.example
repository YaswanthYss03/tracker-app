# ---- Server ----
# HTTP API port (Express)
PORT=3000
# TCP port the GT06N tracker connects to (set the same port on the device)
TCP_PORT=5023
# trace | debug | info | warn | error
LOG_LEVEL=info

# ---- Database (PostgreSQL + TimescaleDB) ----
# Used by docker compose for the database container.
POSTGRES_PASSWORD=change_me_to_a_long_random_password
# Port on this machine for the database (localhost only). Change if 5440 is taken.
DB_HOST_PORT=5440
# Used by the app and Prisma when running on your machine (`npm run dev`).
# Inside Docker, docker-compose.yml overrides this to point at the "db" service.
DATABASE_URL=postgresql://gps:change_me_to_a_long_random_password@localhost:5440/gps

# ---- Security ----
# Secret for admin endpoints (send as the "x-api-key" header). At least 32 characters.
# Leave empty to disable admin endpoints. Generate one with: openssl rand -hex 32
ADMIN_API_KEY=
# Comma-separated list of allowed CORS origins, or * for any
CORS_ORIGIN=*

# ---- Tracker connections ----
# Close a connection that doesn't send a valid login within this time (ms)
LOGIN_TIMEOUT_MS=30000
# Close a tracker connection if nothing is received for this long (ms)
SOCKET_IDLE_TIMEOUT_MS=600000
# Max simultaneous connections from one IP. Mobile networks put many devices
# behind one public IP (CGNAT), so keep this generous.
MAX_CONNECTIONS_PER_IP=50
# How long to wait for a device to reply to a command (ms)
COMMAND_TIMEOUT_MS=30000

# ---- Location filtering ----
# Drop points whose GPS time is this far in the future (minutes) - usually a wrong device time zone
FUTURE_TOLERANCE_MIN=10
# Drop points older than this (days)
MAX_POINT_AGE_DAYS=7
# When parked, ignore movement smaller than this (meters)...
STATIONARY_MIN_DISTANCE_M=15
# ...but still store one point at least this often (seconds)
STATIONARY_STORE_INTERVAL_S=300
# Drop points that imply a speed above this (km/h) - GPS glitches
MAX_IMPLIED_SPEED_KMH=300

# ---- Database writes ----
# Save buffered positions every N ms, or sooner when this many are waiting
BATCH_FLUSH_MS=1000
BATCH_MAX_ROWS=500
# Max positions kept in memory while the database is unavailable
BATCH_MAX_BACKLOG=50000

# ---- User accounts (stage 2) ----
# Secret for signing login tokens (JWT). At least 32 characters; required.
# Generate with: openssl rand -hex 48. Changing it logs everyone out.
JWT_SECRET=
# Access token lifetime (minutes) and refresh token lifetime (days)
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Set to 1 when running behind Nginx/a load balancer, so rate limits see the real client IP
TRUST_PROXY=0

# ---- Alerts & push notifications (stage 3) ----
# Firebase service-account key (Project settings -> Service accounts -> Generate new private key).
# NOT google-services.json (that one goes in the Android app). Missing file = push disabled,
# alerts are still saved and sent to the app over WebSocket.
FIREBASE_CREDENTIALS_FILE=./secrets/firebase.json
# A claimed tracker silent for this long triggers an "offline" alert (minutes)
OFFLINE_AFTER_MIN=10

# ---- HTTPS (stage 4) ----
# Public domain for the API, e.g. api.yourbrand.in (DNS A record -> server IP).
# Caddy gets the Let's Encrypt certificate automatically. "localhost" = self-signed, for testing.
API_DOMAIN=localhost
# Admin website host (needs its own DNS record, e.g. admin.yourbrand.in).
# When set, admin logins only work there. Leave empty for local development.
ADMIN_DOMAIN=
# Host ports for Caddy (change only if 80/443 are taken on this machine)
HTTP_PORT=80
HTTPS_PORT=443

# ---- Backups (stage 4) ----
# Days of local backups to keep in ./backups
BACKUP_KEEP_DAYS=14
# Optional: also copy each backup to this S3 bucket (needs the aws CLI configured on the server)
BACKUP_S3_BUCKET=

# ---- Email & mobile app ----
# Resend API key for password reset emails (resend.com). Empty = codes are only written to the server log.
EMAIL_API_KEY=
# Sender address (must be on a domain verified in Resend)
EMAIL_FROM=Pavakie Tracker <onboarding@resend.dev>
# New accounts confirm their email with a code: auto (only when EMAIL_API_KEY is set) | on | off
EMAIL_VERIFICATION=auto
# Mobile app versions: below APP_MIN_VERSION the app asks the user to update
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0

# "Sign in with Google": OAuth client IDs, comma separated. The FIRST one must be
# the *Web* client ID (Firebase console > Authentication > Google > Web SDK configuration).
# Empty = Google buttons are hidden.
GOOGLE_CLIENT_IDS=

# Shown on the app's "Contact us" page. Contact/partner forms are emailed to SUPPORT_EMAIL
# (needs EMAIL_API_KEY); they are always visible in the admin panel under Inquiries.
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_ADDRESS=
