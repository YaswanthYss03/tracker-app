# Real SMS and email for fee reminders, for the LOCAL backend.
# Copy this file to messaging.env (same folder), fill in the values, and
# restart the backend. Never put these values in chat or in the code.
#
# While messaging.env does not exist, nothing is sent: reminders are only
# recorded.

# ---- Email through Google mail --------------------------------------------
# EMAIL_PROVIDER=gmail
# GMAIL_USER=accounts@yourcollege.edu
# An "app password" made for that Google account (Google Account -> Security
# -> 2-Step Verification -> App passwords). Not the account's own password.
# GMAIL_APP_PASSWORD=
# The name shown to the reader (optional).
# EMAIL_FROM_NAME=Accounts Office

# ---- SMS through Twilio -----------------------------------------------------
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# One of these two: a Messaging Service SID, or the number/sender to send from.
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_SMS_FROM=

# ---- What each message says --------------------------------------------------
# INSTITUTION_NAME=Sri Eshwar College of Engineering
# Where students pay; "/student/fees" is added to it.
# STUDENT_PORTAL_URL=http://localhost:3000

# ---- The daily schedule (9:30 am India time) -------------------------------
# Leave off until you have checked real sending with a test message.
# FEE_REMINDERS_ENABLED=true
