# Local, disposable PostgreSQL 17 rehearsal server for the Finance SQL.
# Container eos-finance-rehearsal-pg17, listening on 127.0.0.1:5441 only.
# Holds the local rehearsal connection and nothing else.
TEST_DATABASE_URL=postgresql://eos_rehearsal:b16a03a94211f0ba633937c0b25842e2158739392a96f0a2@127.0.0.1:5441/eos_finance_rehearsal_test
# Ordinary application-style role (DML only, no DDL). Use for application-role tests.
REHEARSAL_APP_DATABASE_URL=postgresql://eos_finance_app:e8f4ab23edd879a0455e77bfe50326e3c69ec917e7045e13@127.0.0.1:5441/eos_finance_rehearsal_test
# Ordinary role with nothing granted. Use for permission and row-level-security tests.
REHEARSAL_RLS_DATABASE_URL=postgresql://eos_finance_rls_test:d0cd2b1a33abc8b7de03ad63d50d507182e4b8b8a3d07e3f@127.0.0.1:5441/eos_finance_rehearsal_test
