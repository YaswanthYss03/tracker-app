{
  "name": "gt06n-tracker-server",
  "version": "0.5.0",
  "description": "GPS tracking server for GT06N devices: TCP gateway, PostgreSQL/TimescaleDB storage, user accounts and REST API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js | pino-pretty",
    "test": "node --test \"test/**/*.test.js\"",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "admin": "node scripts/admin-cli.js",
    "simulate": "node scripts/simulate-device.js",
    "command": "node scripts/send-command.js",
    "deploy": "bash scripts/deploy.sh",
    "logs": "ssh gps-server \"cd ~/gps-server && docker compose logs -f --tail 50 app\"",
    "postinstall": "prisma generate",
    "test:integration": "node --test --test-concurrency=1 \"itest/**/*.test.js\"",
    "backup": "bash scripts/backup.sh",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web ci && npm --prefix web run build",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin ci && npm --prefix admin run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "prisma": "6.19.3",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4"
  }
}
